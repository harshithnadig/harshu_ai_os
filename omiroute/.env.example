# ==============================================================================
# Harshu AI OS - OmniRoute Gateway Configuration (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env inside omiroute/:
#      Copy-Item .env.example .env
# 2. Populate your legitimate provider API keys below.
# 3. Never commit real API keys to git.
# ==============================================================================

# OmniRoute Local Gateway Server Settings
OMNIROUTE_PORT=20128
OMNIROUTE_HOST=127.0.0.1
OMNIROUTE_DISABLE_TELEMETRY=true

# Legitimate AI Provider API Keys
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=

# Optional: Admin authentication for the local OmniRoute Web UI Dashboard
OMNIROUTE_INITIAL_PASSWORD=
