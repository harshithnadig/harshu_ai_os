HARSHU_AI_OS_MODE=development
GEMINI_API_KEY=replace_with_your_gemini_api_key
GROQ_API_KEY=replace_with_your_groq_api_key

# Security & API Key Authentication (Protected endpoints: /ask, /ask/rag, /ask/agent)
# In production, configure a strong secret key. Missing key fails closed (503).
HARSHU_API_KEY=replace_with_your_api_key

# LOCAL DEVELOPMENT ONLY: Set to 'true' to explicitly bypass API key authentication locally.
# NEVER enable this flag in a deployed, staging, or shared environment.
# HARSHU_AUTH_DISABLED=true
